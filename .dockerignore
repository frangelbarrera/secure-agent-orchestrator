# Version control
.git
.gitignore
.github

# Python caches and virtualenvs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Test / coverage / typing caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Project files that must not leak into the image
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
db.sqlite

# Docs / marketing (kept in repo, not needed at runtime)
README.md
LICENSE
default.conf
render.yaml
worklog.md

# Scripts that are only run locally or in CI
scripts/
